# 复制为 .env 后按需修改（Docker 部署用 docker-compose.yml 里的 environment，不读这个文件）

# 监听端口
PORT=3000
# 访问密钥：新浏览器配对时填写。留空则首次启动自动生成，保存在 DATA_DIR/sync-secret
SYNC_SECRET=
# 应用密钥（加密落库的配置）：pnpm haze key:generate 生成；scripts/start.mjs 在留空时自动生成到 DATA_DIR/app-key
APP_KEY=
# 数据目录与 SQLite 数据库文件
DATA_DIR=./data
DATABASE_URL=file:./data/app.db
# 扩展「账号」页显示的名字
SYNC_NAME=自部署同步
# 位于 Nginx / Caddy 等反向代理之后时设为 true
TRUST_PROXY=false
# 允许跨域访问的来源，逗号分隔；默认任意来源
CORS_ORIGIN=*
